{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@web/lib/types": ["../lib/types/index.ts"],
      "@web/lib/types/*": ["../lib/types/*"],
      "@web/utils/*": ["../lib/utils/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../lib/types/index.ts"],
  "exclude": ["**/node_modules", "**/Pods"]
}
